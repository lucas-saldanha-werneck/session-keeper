{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/bin/claude-save", "--warn"], "timeout": 5 }
        ]
      },
      {
        "matcher": "startup|resume|fork",
        "hooks": [
          { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/bin/claude-folder-title"], "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash", "args": ["${CLAUDE_PLUGIN_ROOT}/bin/claude-restart", "--stop-hook"], "timeout": 10 }
        ]
      }
    ]
  }
}
